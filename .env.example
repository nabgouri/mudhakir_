# Copy to .env.local (not committed) for `npx expo start`. EAS builds read
# the same names from EAS environment variables. See docs/setup-supabase.md.
# Both values are public; never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-key
